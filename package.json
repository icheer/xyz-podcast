{
  "name": "xyz-podcast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:scheduled": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply xyz-podcast-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply xyz-podcast-db --remote",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "predeploy": "npm run check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vue/compiler-dom": "3.5.45",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "wrangler": "^4.0.0"
  }
}
